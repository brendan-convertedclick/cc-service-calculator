VITE_SUPABASE_URL=https://lpgwxacoqiqpcfpkklib.supabase.co
VITE_SUPABASE_ANON_KEY=sbp_777930ae45afe6e431fe33d362d9b58a0a351a08

# Figma design token sync — used by `npm run tokens:sync`.
# Generate a personal access token at https://www.figma.com/settings (scope: file_variables:read).
# FIGMA_FILE_KEY is the key from your Figma file URL: figma.com/design/<FILE_KEY>/...
FIGMA_ACCESS_TOKEN=
FIGMA_FILE_KEY=

# Sync wiki SoWs into the master_sows table — used by `npm run sync-sows`.
# Service-role key is required (bypasses RLS); not Vite-prefixed so the
# bundle can never expose it.
SUPABASE_URL=https://lpgwxacoqiqpcfpkklib.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Extra hostnames the Vite dev server should accept (comma-separated), e.g. a
# cloudflared tunnel pointing at localhost:5174. Local/machine-specific — leave
# blank here and set the real hostname in .env.local (gitignored).
DEV_ALLOWED_HOSTS=
