# deps
node_modules/

# session log checkpoint (per-machine, not committed)
.claude/last-logged-sha

# build
dist/
dist-ssr/
.vite/
*.local
*.tsbuildinfo

# env
.env
.env.local
.env.*.local

# IDE
.idea/
.vscode/
*.swp
.DS_Store

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# test
coverage/

# Supabase local
.supabase/
supabase/.temp/

# Screenshots and generated images
*.png
# …except the brand assets in public/, which the app actually ships. Without
# this, public/conductor-mark.png is untracked and a fresh clone 404s the logo
# in index.html, IconRail and Login. Deliberately public/*.png and not /*.png —
# the latter would also un-ignore Playwright's generated output.
!public/*.png

# Playwright MCP scratch
.playwright-mcp/
.superpowers/

playwright-report/
test-results/
.worktrees
.claude/worktrees/

# Claude Code task attribution sidecar
.cc-task
