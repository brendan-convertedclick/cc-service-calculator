#!/bin/sh
# core.hooksPath points at .githooks, which hides anything in .git/hooks. A
# machine-local post-commit (the ClickUp AI-usage logger on Brendan's Mac) lives
# there, so hand over to it when it exists. This file must never fail a commit.
local_hook="$(git rev-parse --git-common-dir)/hooks/post-commit"
[ -x "$local_hook" ] && "$local_hook" "$@"
exit 0
