SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Only needed to serve over HTTP (npm run http). Every tool runs on the service
# role key, so this token is the only thing between the internet and the whole
# database — generate it with `openssl rand -hex 32` and rotate it when someone
# leaves. The server refuses to start without it.
MCP_AUTH_TOKEN=
MCP_HTTP_PORT=8787

# Where the app lives, so tools can hand back a link somebody can open.
CONDUCTOR_APP_URL=https://conductor.convertedclick.co.za
